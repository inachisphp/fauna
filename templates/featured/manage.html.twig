{% extends '@Fauna/layout.html.twig' %}

{% block title %}Manage Featured Species - Fauna{% endblock %}

{% block fauna_body %}

<main class="fauna-container" id="maincontent">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="fauna-alert fauna-alert-{{ label }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <header class="fauna-page-header">
        <div>
            <h1>Manage Featured Species</h1>
            <p class="fauna-page-subtitle">Review and schedule species features for the Fauna homepage.</p>
        </div>
        <a href="{{ path('fauna_featured_new') }}" class="fauna-btn" role="button">Add Featured Entry</a>
    </header>

    {% if all_featured is not empty %}
        <div class="fauna-card fauna-card-table">
            <table class="fauna-table" aria-label="Featured species schedule">
                <thead>
                    <tr>
                        <th scope="col">Species</th>
                        <th scope="col">Scheduled</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for featured in all_featured %}
                        <tr>
                            <td>
                                <strong>{{ featured.title }}</strong>
                                {% if featured.species %}
                                    <span class="fauna-text-muted fauna-text-small fauna-block fauna-italic">{{ featured.species.latin }}</span>
                                {% endif %}
                            </td>
                            <td class="fauna-text-muted fauna-text-small">
                                {% if featured.scheduleDate %}
                                    <time datetime="{{ featured.scheduleDate|date('Y-m-d\\TH:i') }}">{{ featured.scheduleDate|date('d M Y H:i') }}</time>
                                {% else %}
                                    <em>Immediate</em>
                                {% endif %}
                            </td>
                            <td>
                                {% if featured.isLive %}
                                    <span class="fauna-pill fauna-pill--live">Live</span>
                                {% else %}
                                    <span class="fauna-pill fauna-pill--draft">Draft</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('fauna_featured_edit', {id: featured.id.toString()}) }}" class="fauna-btn fauna-btn-small">Edit</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="fauna-card fauna-card-center">
            <h2>No featured entries yet</h2>
            <p class="fauna-text-muted fauna-margin-bottom-1">Schedule a species to appear on the homepage.</p>
            <a href="{{ path('fauna_featured_new') }}" class="fauna-btn" role="button">Add First Entry</a>
        </div>
    {% endif %}
</main>
{% endblock %}
