{% extends '@Fauna/layout.html.twig' %}

{% block title %}{{ taxonomy.type|capitalize }}: {{ taxonomy.name }} - Fauna{% endblock %}

{% block fauna_body %}

<main class="fauna-container" id="maincontent">
    <header class="fauna-page-header">
        <div>
            {% if parent_path is not empty %}
                <nav aria-label="Breadcrumb" class="fauna-breadcrumb fauna-breadcrumb--spaced">
                    <ol class="fauna-taxonomy-path">
                        {% for ancestor in parent_path %}
                            <li>
                                <a class="fauna-tax-badge" href="{{ path('fauna_taxonomy_show', {id: ancestor.id.toString()}) }}">
                                    <strong>{{ ancestor.type }}</strong>: <em>{{ ancestor.name }}</em>
                                </a>
                            </li>
                        {% endfor %}
                    </ol>
                </nav>
            {% endif %}

            <span class="fauna-overline">{{ taxonomy.type }}</span>
            <h1>{{ taxonomy.name }}</h1>
            {% if taxonomy.common %}
                <p class="fauna-page-subtitle">{{ taxonomy.common }}</p>
            {% endif %}

            <div class="fauna-toolbar fauna-margin-top-1">
                <span class="fauna-pill fauna-pill--live">{{ children|length }} subgroups</span>
                <span class="fauna-pill fauna-pill--draft">{{ species|length }} species</span>
            </div>
        </div>
    </header>

    <article class="fauna-card">
        <section aria-labelledby="subgroups-heading" class="fauna-page-section">
            <h2 id="subgroups-heading" class="fauna-section-title">Subgroups</h2>
            <ul class="fauna-list-reset fauna-grid-cols-2">
                {% for child in children %}
                    <li>
                        <a href="{{ path('fauna_taxonomy_show', {id: child.id.toString()}) }}" class="fauna-card-link">
                            {% if child.common %}
                                <strong>{{ child.common }}</strong>
                            {% endif %}
                            <em class="fauna-text-muted fauna-text-small">{{ child.name }}</em>
                            <span class="fauna-text-muted fauna-text-small fauna-inline-label fauna-capitalize">{{ child.type }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>

        {% if species is not empty %}
            <section aria-labelledby="species-heading" class="fauna-page-section">
                <h2 id="species-heading" class="fauna-section-title">Species in this {{ taxonomy.type }}</h2>
                <ul class="fauna-list-reset fauna-grid-cols-2">
                    {% for s in species %}
                        <li class="fauna-card fauna-card-compact">
                            <div class="fauna-card-header fauna-align-center">
                                <div>
                                    <a href="{{ path('fauna_species_show', {id: s.id.toString()}) }}" class="fauna-card-link">{{ s.name }}</a>
                                    <em class="fauna-text-muted fauna-inline-label">{{ s.latin }}</em>
                                </div>
                                {% if s.iucn %}
                                    <span class="fauna-iucn-badge fauna-iucn-badge--{{ s.iucn|lower }}">{{ s.iucn }}</span>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% if children is empty and species is empty %}
            <p class="fauna-text-muted fauna-italic">No subgroups or species found in this taxonomic group.</p>
        {% endif %}
    </article>
</main>
{% endblock %}
