{% extends '@Fauna/layout.html.twig' %}

{% block title %}Species - Fauna{% endblock %}

{% block fauna_body %}

<main class="fauna-container" id="maincontent">
    <header class="fauna-header-row">
        <h1 class="fauna-no-margin">Species</h1>
    </header>

    {% if results is defined and results is not empty %}
        <p class="fauna-text-muted fauna-margin-bottom-1">
            Found {{ results|length }} result{{ results|length != 1 ? 's' }} for <strong>{{ query }}</strong>
        </p>
        <ul class="fauna-list-reset fauna-grid">
            {% for species in results %}
                <li class="fauna-card fauna-card-compact">
                    <div class="fauna-card-header">
                        <div>
                            <h2 class="fauna-heading-tight">
                                <a href="{{ path('fauna_species_show', {id: species.id.toString()}) }}">{{ species.name }}</a>
                            </h2>
                            <em class="fauna-text-muted">{{ species.latin }}</em>
                        </div>
                        {% if species.iucn %}
                            <span class="fauna-iucn-badge fauna-iucn-badge--{{ species.iucn|lower }}">{{ species.iucn }}</span>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% elseif query is defined and query is not empty %}
        <div class="fauna-card fauna-card-center">
            <p class="fauna-text-muted">No species matched "<strong>{{ query }}</strong>". Try a different name.</p>
        </div>
    {% else %}
        <div class="fauna-card fauna-card-center">
            <p class="fauna-text-muted">Use the search below to find a species.</p>
        </div>
    {% endif %}

    <div class="fauna-card fauna-page-section">
        <form action="{{ path('fauna_species_list') }}" method="get" aria-label="Search for a species">
            <div class="fauna-form-group">
                <label for="species_q">Search by common or scientific name</label>
                <input type="text" name="q" id="species_q" value="{{ query ?? '' }}"
                       placeholder="e.g. House Sparrow or Passer domesticus" autofocus />
            </div>
            <button type="submit" class="fauna-btn">Search</button>
        </form>
    </div>
</main>
{% endblock %}
