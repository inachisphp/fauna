{% extends '@Fauna/layout.html.twig' %}

{% block title %}Sighting: {{ sighting.species.name }} - Fauna{% endblock %}

{% block fauna_body %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<main class="fauna-container" id="maincontent">
    <nav aria-label="Breadcrumb" class="fauna-breadcrumb fauna-breadcrumb--spaced">
        <a href="{{ path('fauna_lifelist') }}">← Lifelist</a>
        {% if sighting.trip %}
            / <a href="{{ path('fauna_trip_show', {id: sighting.trip.id.toString()}) }}">{{ sighting.trip.name }}</a>
        {% endif %}
    </nav>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="fauna-alert fauna-alert-{{ label }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <article class="fauna-card" itemscope itemtype="https://schema.org/Observation">
        <header>
            <h1 itemprop="about" itemscope itemtype="https://schema.org/Taxon">
                <span itemprop="name">{{ sighting.species.name }}</span>
            </h1>
            <p class="fauna-subtitle">{{ sighting.species.latin }}</p>
        </header>

        <div class="fauna-detail-grid">
            <div class="fauna-detail-block">
                <strong>Count</strong>
                <p class="fauna-detail-value">{{ sighting.count }}</p>
            </div>
            <div class="fauna-detail-block">
                <strong>Date Recorded</strong>
                <p class="fauna-detail-value-secondary" itemprop="temporalCoverage">
                    <time datetime="{{ sighting.date|date('Y-m-d\\TH:i') }}">
                        {{ sighting.date|date('d M Y \\a\\t H:i') }}
                    </time>
                </p>
            </div>
            {% if sighting.trip %}
                <div class="fauna-detail-block">
                    <strong>Trip</strong>
                    <p class="fauna-no-margin"><a href="{{ path('fauna_trip_show', {id: sighting.trip.id.toString()}) }}">{{ sighting.trip.name }}</a></p>
                </div>
            {% endif %}
        </div>

        {% if sighting.notes %}
            <section aria-labelledby="notes-heading" class="fauna-page-section">
                <h2 id="notes-heading" class="fauna-section-title fauna-text-muted">Notes</h2>
                <p>{{ sighting.notes|nl2br }}</p>
            </section>
        {% endif %}

        <section aria-labelledby="location-heading" class="fauna-page-section" itemscope itemtype="https://schema.org/Place">
            <h2 id="location-heading" class="fauna-section-title">Location Details</h2>
            {% if sighting.location %}
                <p><strong>Place:</strong> <span itemprop="name">{{ sighting.location }}</span></p>
            {% endif %}
            {% if sighting.country %}
                <p><strong>Country:</strong> <span itemprop="addressCountry">{{ sighting.country.name }}</span></p>
            {% endif %}
            {% if sighting.latitude and sighting.longitude %}
                <p class="geo" itemprop="geo" itemscope itemtype="https://schema.org/GeoCoordinates">
                    <strong>Coordinates:</strong>
                    <span itemprop="latitude">{{ sighting.latitude }}</span>,
                    <span itemprop="longitude">{{ sighting.longitude }}</span>
                </p>
                <div id="map_canvas" class="fauna-map" aria-label="Map showing sighting location"></div>
            {% endif %}
        </section>

        {% if app.user and app.user == sighting.user %}
            <div class="fauna-toolbar">
                <a href="{{ path('fauna_sighting_edit', {id: sighting.id.toString()}) }}" class="fauna-btn" role="button">Edit Sighting</a>
                <form action="{{ path('fauna_sighting_delete', {id: sighting.id.toString()}) }}" method="post" onsubmit="return confirm('Delete this sighting? This cannot be undone.');" class="fauna-form-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-sighting-' ~ sighting.id.toString()) }}">
                    <button type="submit" class="fauna-btn fauna-btn-danger">Delete</button>
                </form>
            </div>
        {% endif %}
    </article>
</main>

{% if sighting.latitude and sighting.longitude %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const lat = {{ sighting.latitude }};
    const lng = {{ sighting.longitude }};
    const map = L.map('map_canvas').setView([lat, lng], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);
    L.marker([lat, lng])
        .addTo(map)
        .bindPopup('<strong>{{ sighting.species.name|e('js') }}</strong>')
        .openPopup();
});
</script>
{% endif %}
{% endblock %}
