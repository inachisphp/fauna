{% extends '@Fauna/layout.html.twig' %}

{% block title %}Your Lifelist - Fauna{% endblock %}

{% block fauna_body %}

<main class="fauna-container" id="maincontent">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="fauna-alert fauna-alert-{{ label }}" role="alert">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <header class="fauna-page-header">
        <div>
            <h1>Your Lifelist</h1>
            <p class="fauna-page-subtitle">A quick view of species you've seen, with IUCN status and recent sightings.</p>
        </div>
        <div class="fauna-toolbar">
            <a href="{{ path('fauna_sighting_new') }}" class="fauna-btn" role="button">Add Sighting</a>
            <a href="{{ path('fauna_trip_list') }}" class="fauna-btn fauna-secondary" role="button">My Trips</a>
        </div>
    </header>

    {% if results is not empty %}
        <ul class="fauna-list-reset fauna-grid">
            {% for species in results %}
                <li class="fauna-card fauna-card-compact">
                    <div class="fauna-card-header fauna-card-header-center">
                        <div>
                            <h2 class="fauna-heading-tight">
                                <a href="{{ path('fauna_species_show', {id: species.id.toString()}) }}">
                                    {{ species.name }}
                                </a>
                            </h2>
                            <em class="fauna-text-muted fauna-text-small">{{ species.latin }}</em>
                        </div>
                        <div>
                            {% if species.iucn %}
                                <span class="fauna-iucn-badge fauna-iucn-badge--{{ species.iucn|lower }}" aria-label="IUCN conservation status: {{ species.iucn }}">{{ species.iucn }}</span>
                            {% endif %}
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>

        {% if totalPages > 1 %}
            <nav aria-label="Lifelist pagination" class="fauna-toolbar fauna-toolbar-center fauna-margin-top-2">
                {% if page > 1 %}
                    <a href="{{ path('fauna_lifelist', {page: page - 1}) }}" class="fauna-btn fauna-btn-small">Previous</a>
                {% endif %}
                <span class="fauna-text-muted fauna-align-self-center">Page {{ page }} of {{ totalPages }}</span>
                {% if page < totalPages %}
                    <a href="{{ path('fauna_lifelist', {page: page + 1}) }}" class="fauna-btn fauna-btn-small">Next</a>
                {% endif %}
            </nav>
        {% endif %}
    {% else %}
        <div class="fauna-card fauna-card-center">
            <h2>No sightings recorded yet!</h2>
            <p class="fauna-text-muted fauna-margin-bottom-1">Start building your lifelist by adding your first wildlife sighting.</p>
            <a href="{{ path('fauna_sighting_new') }}" class="fauna-btn" role="button">Log a Sighting</a>
        </div>
    {% endif %}
</main>
{% endblock %}
