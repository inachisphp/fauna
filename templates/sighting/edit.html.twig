{% extends 'base.html.twig' %}

{% block title %}{{ is_new ? 'Add Sighting' : 'Edit Sighting' }} - Fauna{% endblock %}

{% block body %}
{% include '@Fauna/_styles.html.twig' %}
<!-- Include Leaflet CSS and JS for mapping -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<main class="fauna-container" id="maincontent">
    <nav aria-label="Breadcrumb">
        <a href="{{ path('fauna_lifelist') }}">Back to Lifelist</a>
    </nav>

    <h1>{{ is_new ? 'Add Sighting' : 'Edit Sighting' }}</h1>

    <div class="fauna-card">
        {{ form_start(form, {'attr': {'class': 'nice_form', 'id': 'sighting_form'}}) }}
            
            <div class="fauna-form-group">
                {{ form_label(form.species, 'Species Common (Scientific) Name') }}
                {{ form_widget(form.species) }}
                {{ form_errors(form.species) }}
            </div>

            <div class="fauna-form-group">
                {{ form_label(form.trip, 'Associated Trip') }}
                {{ form_widget(form.trip) }}
                {{ form_errors(form.trip) }}
            </div>

            <div class="fauna-form-group">
                {{ form_label(form.country, 'Country') }}
                {{ form_widget(form.country) }}
                {{ form_errors(form.country) }}
            </div>

            <div class="fauna-form-group">
                {{ form_label(form.location, 'Location Name') }}
                {{ form_widget(form.location) }}
                {{ form_errors(form.location) }}
            </div>

            <fieldset style="border: 1px solid var(--fauna-border); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem;">
                <legend style="padding: 0 0.5rem; font-weight: 600; color: #ffffff;">Coordinates</legend>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                    <div class="fauna-form-group" style="margin-bottom: 0;">
                        {{ form_label(form.latitude, 'Latitude') }}
                        {{ form_widget(form.latitude, {'id': 'sighting_lat'}) }}
                        {{ form_errors(form.latitude) }}
                    </div>
                    <div class="fauna-form-group" style="margin-bottom: 0;">
                        {{ form_label(form.longitude, 'Longitude') }}
                        {{ form_widget(form.longitude, {'id': 'sighting_long'}) }}
                        {{ form_errors(form.longitude) }}
                    </div>
                </div>

                <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem;">
                    <button type="button" class="fauna-btn" style="background-color: #2b3b2b;" onclick="getCurrentLocation()">
                        Use Current Location
                    </button>
                </div>

                <div id="map_canvas" class="fauna-map" style="display: none;"></div>
            </fieldset>

            <div class="fauna-form-group">
                {{ form_label(form.notes, 'Sighting Notes') }}
                {{ form_widget(form.notes) }}
                {{ form_errors(form.notes) }}
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="fauna-form-group">
                    {{ form_label(form.count, 'Count') }}
                    {{ form_widget(form.count) }}
                    {{ form_errors(form.count) }}
                </div>
                <div class="fauna-form-group">
                    {{ form_label(form.date, 'Date & Time Sighting Made') }}
                    {{ form_widget(form.date) }}
                    {{ form_errors(form.date) }}
                </div>
            </div>

            <div class="fauna-form-group">
                {{ form_label(form.photograph, 'Photograph URL or Filename') }}
                {{ form_widget(form.photograph) }}
                {{ form_errors(form.photograph) }}
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <button type="submit" class="fauna-btn">Save Sighting</button>
                <a href="{{ path('fauna_lifelist') }}" class="fauna-btn" style="background-color: #3d3d3d;" role="button">Cancel</a>
            </div>

        {{ form_end(form) }}
    </div>
</main>

<script>
    let map = null;
    let marker = null;

    function initMap() {
        const latInput = document.getElementById('sighting_lat');
        const longInput = document.getElementById('sighting_long');
        const mapCanvas = document.getElementById('map_canvas');

        let lat = parseFloat(latInput.value);
        let lng = parseFloat(longInput.value);

        if (isNaN(lat) || isNaN(lng)) {
            // Default center if no coordinates are input yet
            lat = 51.505;
            lng = -0.09;
        } else {
            mapCanvas.style.display = 'block';
        }

        map = L.map('map_canvas').setView([lat, lng], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        if (!isNaN(parseFloat(latInput.value)) && !isNaN(parseFloat(longInput.value))) {
            marker = L.marker([lat, lng]).addTo(map);
        }

        // Allow clicking on map to place marker and fill input fields
        map.on('click', function(e) {
            const clickLat = e.latlng.lat;
            const clickLng = e.latlng.lng;
            
            latInput.value = clickLat.toFixed(6);
            longInput.value = clickLng.toFixed(6);
            mapCanvas.style.display = 'block';
            
            updateMarker(clickLat, clickLng);
        });

        // Add listeners to text inputs to update map
        latInput.addEventListener('change', updateMapFromInputs);
        longInput.addEventListener('change', updateMapFromInputs);
    }

    function updateMarker(lat, lng) {
        if (marker) {
            marker.setLatLng([lat, lng]);
        } else {
            marker = L.marker([lat, lng]).addTo(map);
        }
        map.setView([lat, lng], 13);
    }

    function updateMapFromInputs() {
        const latInput = document.getElementById('sighting_lat');
        const longInput = document.getElementById('sighting_long');
        const mapCanvas = document.getElementById('map_canvas');

        const lat = parseFloat(latInput.value);
        const lng = parseFloat(longInput.value);

        if (!isNaN(lat) && !isNaN(lng)) {
            mapCanvas.style.display = 'block';
            if (map) {
                map.invalidateSize();
                updateMarker(lat, lng);
            }
        }
    }

    function getCurrentLocation() {
        const latInput = document.getElementById('sighting_lat');
        const longInput = document.getElementById('sighting_long');
        const mapCanvas = document.getElementById('map_canvas');

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;
                    latInput.value = lat.toFixed(6);
                    longInput.value = lng.toFixed(6);
                    mapCanvas.style.display = 'block';
                    if (map) {
                        map.invalidateSize();
                        updateMarker(lat, lng);
                    }
                },
                (error) => {
                    alert('Error getting location: ' + error.message);
                }
            );
        } else {
            alert('Geolocation is not supported by your browser.');
        }
    }

    // Initialize map on load
    document.addEventListener('DOMContentLoaded', () => {
        initMap();
    });
</script>
{% endblock %}
