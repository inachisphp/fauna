{% extends '@Fauna/layout.html.twig' %}

{% block title %}{{ species.name }} - Species Details{% endblock %}

{% block fauna_body %}

<main class="fauna-container" id="maincontent">
    <nav aria-label="Breadcrumb" class="fauna-breadcrumb fauna-breadcrumb--spaced">
        <a href="{{ path('fauna_lifelist') }}">← Lifelist</a>
    </nav>

    <article class="fauna-card" itemscope itemtype="https://schema.org/Taxon">
        <header>
            <h1 itemprop="name">{{ species.name }}</h1>
            <p itemprop="scientificName" class="fauna-subtitle">
                {{ species.latin }}
            </p>
        </header>

        {% if species.iucn %}
            <div class="fauna-meta fauna-margin-bottom-1">
                <span class="fauna-iucn-badge fauna-iucn-badge--{{ species.iucn|lower }}" aria-label="IUCN Conservation Status: {{ species.iucn }}">
                    IUCN: {{ species.iucn }}
                </span>
            </div>
        {% endif %}

        {% if species.images is not empty %}
            {% set firstImage = species.images|first %}
            <div class="fauna-photo-container" itemscope itemtype="https://schema.org/Photograph">
                <img src="{{ firstImage.url }}" alt="Photograph of {{ species.name }}" class="fauna-photo" itemprop="image">
                {% if firstImage.author %}
                    <span class="fauna-photo-author" itemprop="author">Photo by {{ firstImage.author }}</span>
                {% endif %}
            </div>
        {% endif %}

        <section aria-labelledby="classification-title" class="fauna-page-section">
            <h2 id="classification-title" class="fauna-section-title">Classification</h2>
            <nav aria-label="Classification" class="fauna-breadcrumb fauna-breadcrumb--classification">
                {% for tax in taxonomy_path %}
                    <a href="{{ path('fauna_taxonomy_show', {id: tax.id.toString()}) }}" title="View taxonomic level {{ tax.name }}">
                        <strong>{{ tax.type }}:</strong> <em>{{ tax.name }}</em>{% if tax.common %} ({{ tax.common }}){% endif %}
                    </a>
                {% endfor %}
            </nav>
        </section>

        {% if species.description %}
            <section aria-labelledby="about-title" class="fauna-page-section">
                <h2 id="about-title" class="fauna-section-title">About</h2>
                <div itemprop="description" class="fauna-description-markdown">
                    <p>{{ species.description|nl2br }}</p>
                </div>
            </section>
        {% endif %}

        {% if related|length > 1 %}
            <section aria-labelledby="related-title" class="fauna-page-section">
                <h3 id="related-title" class="fauna-section-title">Other species in this genus</h3>
                <ul class="fauna-list-reset fauna-grid-cols-2">
                    {% for rspecies in related %}
                        {% if rspecies.id.toString() != species.id.toString() %}
                            <li class="fauna-card fauna-card-compact">
                                <div class="fauna-card-header fauna-align-center">
                                    <div>
                                        <a href="{{ path('fauna_species_show', {id: rspecies.id.toString()}) }}" class="fauna-card-link">{{ rspecies.name }}</a>
                                        <em class="fauna-text-muted fauna-inline-label">{{ rspecies.latin }}</em>
                                    </div>
                                    {% if rspecies.iucn %}
                                        <span class="fauna-iucn-badge fauna-iucn-badge--{{ rspecies.iucn|lower }}" aria-label="IUCN: {{ rspecies.iucn }}">{{ rspecies.iucn }}</span>
                                    {% endif %}
                                </div>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </article>
</main>
{% endblock %}
