{% extends '@Fauna/layout.html.twig' %}

{% block title %}My Trips - Fauna{% endblock %}

{% block fauna_body %}

<main class="fauna-container" id="maincontent">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="fauna-alert fauna-alert-{{ label }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <header class="fauna-page-header">
        <div>
            <h1>My Trips</h1>
            <p class="fauna-page-subtitle">Plan and review trips, then add sightings to build your personal wildlife log.</p>
        </div>
        <a href="{{ path('fauna_trip_new') }}" class="fauna-btn" role="button">Plan New Trip</a>
    </header>

    {% if trips is not empty %}
        <ul class="fauna-list-reset fauna-grid">
        {% for item in trips %}
            {% set trip = item.entity %}
            <li class="fauna-card">
                <div class="fauna-card-header">
                    <div>
                        <h2 class="fauna-heading-tight">
                            <a href="{{ path('fauna_trip_show', {id: trip.id.toString()}) }}">{{ trip.name }}</a>
                        </h2>
                        {% if trip.location %}
                            <p class="fauna-text-muted fauna-subtitle">📍 {{ trip.location }}</p>
                        {% endif %}
                        {% if trip.startDate %}
                            <p class="fauna-text-muted fauna-text-small fauna-no-margin">
                                <time datetime="{{ trip.startDate|date('Y-m-d') }}">{{ trip.startDate|date('d M Y') }}</time>
                                —
                                <time datetime="{{ trip.endDate|date('Y-m-d') }}">{{ trip.endDate|date('d M Y') }}</time>
                                ({{ item.trip_length }} day{{ item.trip_length != 1 ? 's' }})
                            </p>
                        {% endif %}
                    </div>
                    <div class="fauna-stat-block">
                        <p class="fauna-detail-value fauna-detail-value--primary">{{ item.sighting_count }}</p>
                        <p class="fauna-text-muted fauna-text-small fauna-no-margin">sighting{{ item.sighting_count != 1 ? 's' }}</p>
                    </div>
                </div>
                <div class="fauna-toolbar">
                    <a href="{{ path('fauna_trip_show', {id: trip.id.toString()}) }}" class="fauna-btn fauna-btn-small">View</a>
                    <a href="{{ path('fauna_trip_edit', {id: trip.id.toString()}) }}" class="fauna-btn fauna-secondary fauna-btn-small">Edit</a>
                    <a href="{{ path('fauna_sighting_new') }}?trip={{ trip.id.toString() }}" class="fauna-btn fauna-secondary fauna-btn-small">Add Sighting</a>
                </div>
            </li>
        {% endfor %}
        </ul>

        {% if totalPages > 1 %}
            <nav aria-label="Trip pagination" class="fauna-toolbar fauna-toolbar-center fauna-margin-top-2">
                {% if page > 1 %}
                    <a href="{{ path('fauna_trip_list', {page: page - 1}) }}" class="fauna-btn fauna-btn-small">← Previous</a>
                {% endif %}
                <span class="fauna-text-muted fauna-align-self-center">Page {{ page }} of {{ totalPages }}</span>
                {% if page < totalPages %}
                    <a href="{{ path('fauna_trip_list', {page: page + 1}) }}" class="fauna-btn fauna-btn-small">Next →</a>
                {% endif %}
            </nav>
        {% endif %}
    {% else %}
        <div class="fauna-card fauna-card-center">
            <h2>No trips recorded yet</h2>
            <p class="fauna-text-muted fauna-margin-bottom-1">Plan a trip to start grouping your sightings together.</p>
            <a href="{{ path('fauna_trip_new') }}" class="fauna-btn" role="button">Plan Your First Trip</a>
        </div>
    {% endif %}
</main>
{% endblock %}
