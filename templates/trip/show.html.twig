{% extends '@Fauna/layout.html.twig' %}

{% block title %}{{ trip.name }} - Fauna{% endblock %}

{% block fauna_body %}

<main class="fauna-container" id="maincontent">
    <nav aria-label="Breadcrumb" class="fauna-breadcrumb fauna-breadcrumb--spaced">
        <a href="{{ path('fauna_trip_list') }}">← My Trips</a>
    </nav>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="fauna-alert fauna-alert-{{ label }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <article class="fauna-card">
        <header class="fauna-card-header">
            <div>
                <h1 class="fauna-heading-tight">{{ trip.name }}</h1>
                {% if trip.location %}
                    <p class="fauna-text-muted fauna-subtitle">📍 {{ trip.location }}</p>
                {% endif %}
                {% if trip.startDate %}
                    <p class="fauna-text-muted fauna-text-small fauna-no-margin">
                        <time datetime="{{ trip.startDate|date('Y-m-d') }}">{{ trip.startDate|date('d M Y') }}</time>
                        –
                        <time datetime="{{ trip.endDate|date('Y-m-d') }}">{{ trip.endDate|date('d M Y') }}</time>
                    </p>
                {% endif %}
            </div>
            {% if app.user and app.user == trip.user %}
                <div class="fauna-toolbar fauna-toolbar-no-shrink">
                    <a href="{{ path('fauna_trip_edit', {id: trip.id.toString()}) }}" class="fauna-btn fauna-secondary fauna-btn-small">Edit Trip</a>
                    <form action="{{ path('fauna_trip_delete', {id: trip.id.toString()}) }}" method="post" onsubmit="return confirm('Delete this trip? This cannot be undone.');" class="fauna-form-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-trip-' ~ trip.id.toString()) }}">
                        <button type="submit" class="fauna-btn fauna-btn-danger fauna-btn-small">Delete</button>
                    </form>
                </div>
            {% endif %}
        </header>

        <section aria-labelledby="sightings-heading">
            <div class="fauna-header-row fauna-margin-bottom-1">
                <h2 id="sightings-heading" class="fauna-section-title">Sightings</h2>
                {% if app.user and app.user == trip.user %}
                    <a href="{{ path('fauna_sighting_new') }}?trip={{ trip.id.toString() }}" class="fauna-btn fauna-btn-small">Add Sighting</a>
                {% endif %}
            </div>

            {% if sightings is not empty %}
                <ul class="fauna-list-reset">
                {% for sighting in sightings %}
                    <li class="fauna-card fauna-card-compact">
                        <div class="fauna-card-header fauna-card-header-center">
                            <div>
                                <a href="{{ path('fauna_sighting_show', {id: sighting.id.toString()}) }}" class="fauna-card-link">{{ sighting.species.name }}</a>
                                <span class="fauna-text-muted fauna-inline-label">{{ sighting.species.latin }}</span>
                                {% if sighting.location %}
                                    <span class="fauna-text-muted fauna-text-small fauna-text-block">📍 {{ sighting.location }}</span>
                                {% endif %}
                            </div>
                            <div class="fauna-card-stat-right">
                                <span class="fauna-detail-value-secondary fauna-detail-value--primary">{{ sighting.count }}</span>
                                <span class="fauna-text-muted fauna-text-small fauna-text-block">
                                    <time datetime="{{ sighting.date|date('Y-m-d') }}">{{ sighting.date|date('d M Y') }}</time>
                                </span>
                            </div>
                        </div>
                    </li>
                {% endfor %}
                </ul>
            {% else %}
                <p class="fauna-text-muted">No sightings recorded for this trip yet.</p>
                {% if app.user and app.user == trip.user %}
                    <a href="{{ path('fauna_sighting_new') }}?trip={{ trip.id.toString() }}" class="fauna-btn" role="button">Log First Sighting</a>
                {% endif %}
            {% endif %}
        </section>
    </article>
</main>
{% endblock %}
