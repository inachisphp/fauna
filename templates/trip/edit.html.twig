{% extends '@Fauna/layout.html.twig' %}

{% block title %}{{ is_new ? 'Plan New Trip' : 'Edit Trip: ' ~ trip.name }} - Fauna{% endblock %}

{% block fauna_body %}

<main class="fauna-container" id="maincontent">
    <nav aria-label="Breadcrumb" class="fauna-breadcrumb--spaced">
        {% if is_new %}
            <a href="{{ path('fauna_trip_list') }}">← My Trips</a>
        {% else %}
            <a href="{{ path('fauna_trip_show', {id: trip.id.toString()}) }}">← {{ trip.name }}</a>
        {% endif %}
    </nav>

    <h1>{{ is_new ? 'Plan New Trip' : 'Edit Trip' }}</h1>

    <div class="fauna-card">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            <div class="fauna-form-group">
                {{ form_label(form.name, 'Trip Name') }}
                {{ form_widget(form.name, {'attr': {'autofocus': true, 'aria-required': 'true'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="fauna-form-group">
                {{ form_label(form.location, 'Location') }}
                {{ form_widget(form.location) }}
                {{ form_errors(form.location) }}
                <p class="fauna-text-muted fauna-text-small fauna-margin-top-1">A descriptive location name, e.g. "Yorkshire Dales" or "Kenya Safari".</p>
            </div>

            <div class="fauna-form-grid-2">
                <div class="fauna-form-group">
                    {{ form_label(form.startDate, 'Start Date') }}
                    {{ form_widget(form.startDate) }}
                    {{ form_errors(form.startDate) }}
                </div>
                <div class="fauna-form-group">
                    {{ form_label(form.endDate, 'End Date') }}
                    {{ form_widget(form.endDate) }}
                    {{ form_errors(form.endDate) }}
                </div>
            </div>

            <div class="fauna-toolbar fauna-margin-top-2">
                <button type="submit" class="fauna-btn">{{ is_new ? 'Create Trip' : 'Save Changes' }}</button>
                {% if is_new %}
                    <a href="{{ path('fauna_trip_list') }}" class="fauna-btn fauna-btn-muted" role="button">Cancel</a>
                {% else %}
                    <a href="{{ path('fauna_trip_show', {id: trip.id.toString()}) }}" class="fauna-btn fauna-btn-muted" role="button">Cancel</a>
                {% endif %}
            </div>

        {{ form_end(form) }}
    </div>
</main>
{% endblock %}
