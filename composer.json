{
    "name": "inachisphp/fauna",
    "type": "symfony-bundle",
    "description": "An extension to the Inachis framework for recording wildlife sightings",
    "keywords": ["inachis", "plugin", "wildlife", "fauna"],
    "license": "MIT",
    "authors": [
        {
            "name": "David G. Paul"
        }
    ],
    "require": {
        "php": ">=8.4",
        "doctrine/orm": "^3.0",
        "twig/twig": "^3.0",
        "ramsey/uuid": "^4.7",
        "ramsey/uuid-doctrine": "^2.0",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/doctrine-bridge": "^8.0",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/validator": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Inachis\\Fauna\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inachis\\Fauna\\Tests\\": "tests/"
        }
    }
}
